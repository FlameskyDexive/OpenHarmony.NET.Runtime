<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

	<PropertyGroup>
		<OpenHarmonyArchitecture>arm64</OpenHarmonyArchitecture>
		<OpenHarmonyLegacyRuntimePackPath>$(OpenHarmonyRuntimeRepoRoot)runtime.linux-musl-arm64.microsoft.dotnet.ilcompiler\9.0.0</OpenHarmonyLegacyRuntimePackPath>
		<OpenHarmonyRuntimeAbi>arm64-v8a</OpenHarmonyRuntimeAbi>
		<OpenHarmonyRuntimeManifestPath>$(OpenHarmonyRuntimePackageRoot)\manifest.json</OpenHarmonyRuntimeManifestPath>
		<OpenHarmonyRuntimePackPath Condition="'$(OpenHarmonyTarget)' == 'true'">$(OpenHarmonyRuntimePackageRoot)\arm64-v8a\runtime-pack</OpenHarmonyRuntimePackPath>
		<OpenHarmonyRuntimePackPath Condition="'$(OpenHarmonyTarget)' != 'true'">$(OpenHarmonyLegacyRuntimePackPath)</OpenHarmonyRuntimePackPath>
		<IlcFrameworkNativePath>$(OpenHarmonyRuntimePackPath)\native\</IlcFrameworkNativePath>
		<IlcSdkPath>$(OpenHarmonyRuntimePackPath)\sdk\</IlcSdkPath>
	</PropertyGroup>

	<ItemGroup>
		<NativeSharedLibrary Include="$(OpenHarmonyRuntimePackPath)\native\*" />
	</ItemGroup>

	<Target Name="ValidateOpenHarmonyArm64RuntimePackage" BeforeTargets="PrepareForBuild" Condition="'$(OpenHarmonyTarget)' == 'true'">
		<Error Condition="!Exists('$(OpenHarmonyRuntimeManifestPath)')" Text="OpenHarmony runtime manifest was not found: '$(OpenHarmonyRuntimeManifestPath)'." />
		<Error Condition="!Exists('$(OpenHarmonyRuntimePackPath)\sdk') Or !Exists('$(OpenHarmonyRuntimePackPath)\framework') Or !Exists('$(OpenHarmonyRuntimePackPath)\native')"
			Text="OpenHarmony arm64 runtime package was not found for API $(OpenHarmonyApiLevel). Build releases/$(OpenHarmonyRuntimeVersion) with RuntimePackager first." />
	</Target>

	<Target Name="CopyNativeLibs" BeforeTargets="Publish">
		<Copy SourceFiles="@(NativeSharedLibrary)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
	</Target>

</Project>
