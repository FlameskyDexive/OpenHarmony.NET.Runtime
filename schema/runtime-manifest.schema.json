{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "version", "runtimeCommit", "bindingsCommit", "minimumApi", "verifiedApis", "architectures", "toolVersions", "packages", "sbom"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "version": { "type": "string", "minLength": 1 },
    "runtimeCommit": { "type": "string", "minLength": 1 },
    "bindingsCommit": { "type": "string", "minLength": 1 },
    "minimumApi": { "enum": [15, 18, 20, 23, 26] },
    "verifiedApis": { "type": "array", "items": { "enum": [15, 18, 20, 23, 26] }, "uniqueItems": true },
    "architectures": { "type": "array", "items": { "enum": ["arm64", "x64"] }, "uniqueItems": true },
    "toolVersions": { "type": "object", "additionalProperties": { "type": "string" } },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["apiLevel", "architecture", "abi", "rid", "root", "files"],
        "properties": {
          "apiLevel": { "enum": [15, 18, 20, 23, 26] },
          "architecture": { "enum": ["arm64", "x64"] },
          "abi": { "enum": ["arm64-v8a", "x86_64"] },
          "rid": { "enum": ["linux-musl-arm64", "linux-musl-x64"] },
          "root": { "type": "string", "minLength": 1 },
          "sdk": {
            "type": "object",
            "required": ["folder", "packageVersion", "sha256"],
            "properties": {
              "folder": { "type": "string", "minLength": 1 },
              "packageVersion": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            },
            "additionalProperties": false
          },
          "dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "licenses": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "size", "sha256"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "size": { "type": "integer", "minimum": 0 },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "sbom": {
      "type": "object",
      "required": ["format", "path", "sha256"],
      "properties": {
        "format": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
